Options -MultiViews -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteRule ^api/_ - [F,L]
RewriteRule ^_shell/ - [F,L]
RewriteRule ^vacancy/?$ /api/vacancy-page.php [L,QSA]
RewriteRule ^vacancy/([a-z0-9-]+)/?$ /api/vacancy-page.php?slug=$1 [L,QSA]
RewriteRule ^sitemap-vacancies\.xml$ /api/vacancies-sitemap.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
